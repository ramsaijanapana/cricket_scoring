# ─── Production Docker Compose (.env) ───────────────────────────────────────
# Copy to .env and fill in real values before:
#   docker compose -f docker-compose.prod.yml up -d
#
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ─── PostgreSQL (TimescaleDB) ────────────────────────────────────────────────
POSTGRES_USER=cricket
POSTGRES_PASSWORD=change-me-use-a-strong-password
POSTGRES_DB=cricket_scoring

# ─── JWT (min 32 characters in production) ───────────────────────────────────
JWT_SECRET=change-me-generate-a-real-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-generate-a-real-refresh-secret-32-chars

# ─── CORS (comma-separated allowed origins) ────────────────────────────────────
ALLOWED_ORIGINS=https://your-domain.com

# ─── Host ports (optional — defaults shown) ────────────────────────────────────
# API_PORT applies to staging compose only; production API is internal (nginx proxy).
API_PORT=3001
WEB_PORT=80

# ─── Observability (optional) ──────────────────────────────────────────────────
SENTRY_DSN=
APP_VERSION=latest

# ─── Email / SMTP (optional) ───────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Object storage / S3-compatible (optional) ───────────────────────────────
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_CDN_URL=
